# Aplicacao
NODE_ENV=development
PORT=3000

# Porta publicada pelo container MySQL no computador (use 3307 se 3306 estiver ocupada)
MYSQL_HOST_PORT=3306

# Banco de dados para a API executada fora do Docker
DATABASE_URL="mysql://app_user:app_password@localhost:3306/app_db"

# Valores usados pelo docker-compose.yml
MYSQL_DATABASE=app_db
MYSQL_USER=app_user
MYSQL_PASSWORD=app_password
MYSQL_ROOT_PASSWORD=root_password
