{
  "name": "p2-backend",
  "version": "1.0.0",
  "private": true,
  "description": "API backend em TypeScript, Express, Prisma e MySQL.",
  "main": "dist/Server.js",
  "scripts": {
    "dev": "tsx watch src/Server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/Server.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/Unit/**/*.test.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio"
  },
  "engines": {
    "node": ">=20.19.0 <23"
  },
  "dependencies": {
    "@prisma/client": "^6.11.1",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "morgan": "^1.10.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.3",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.15.19",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "prisma": "^6.11.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
